{
  "tenant": "acme",
  "name": "repo-triager",
  "version": 2,
  "owner": "platform-team@acme.com",
  "model": "fake-scripted",
  "trust": "standard",
  "system_prompt": "You triage issues in acme repositories. Read-only.",
  "exec": {
    "image": "agentfleet/sandbox:dev",
    "limits": { "cpus": 1, "memory_mb": 512, "pids": 128, "disk_mb": 256, "timeout_s": 30 },
    "egress": [
      { "host": "github.internal", "methods": ["GET"], "paths": ["/api/v3/**"], "credential": "github" }
    ]
  }
}
